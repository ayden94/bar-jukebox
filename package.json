{
  "name": "bar-jukebox",
  "private": true,
  "scripts": {
    "dev": "fluo dev",
    "dev:client": "vite build --watch --config vite.client.config.ts",
    "build": "vite build --config vite.client.config.ts && vite build --config vite.server.config.ts",
    "ci": "bun run typecheck && bun run check && bun test && bun run build && bun test-flow.ts && bun tests/react-navigation.browser.ts && bun tests/navigation-protection.browser.ts && bun tests/music-contract.browser.ts",
    "start": "bun dist/server/main.js",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bunx biome check src test-flow.ts"
  },
  "dependencies": {
    "@fluojs/core": "^2.1.3",
    "@fluojs/drizzle": "2.1.2",
    "@fluojs/http": "^3.2.0",
    "@fluojs/platform-bun": "^3.1.0",
    "@fluojs/react": "^0.3.0",
    "@fluojs/runtime": "^3.1.3",
    "@fluojs/validation": "^2.1.2",
    "@fluojs/vite": "^2.0.1",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "0.45.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.9",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.14",
    "@fluojs/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "type": "module"
}
