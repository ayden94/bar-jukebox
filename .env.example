ADMIN_TOKEN=replace-with-a-long-random-token
PORT=5173
# 기기 쿠키 서명 키 (미설정 시 ADMIN_TOKEN 사용, 변경 시 기존 기기 쿠키 무효화)
# DEVICE_COOKIE_SECRET=replace-with-another-long-random-token
# QR에 들어갈 공개 주소 (미설정 시 LAN IP 자동 감지)
# IP가 바뀌면 QR 전체를 다시 인쇄해야 하니 고정 호스트명(mDNS) 권장
# BASE_URL=http://barjukebox.local:5173
# 음악 설정: 환경 변수 > 관리자에서 저장한 다음 시작 설정 > macOS 기본값 순이에요.
# 환경 변수로 지정한 필드는 관리자 화면에서 잠겨요. 변경 후 서버를 다시 시작해주세요.
# 현재 등록된 실행 방식은 macOS의 AppleScript예요. MusicKit은 아직 지원하지 않아요.
# MUSIC_PROVIDER=apple-music
# MUSIC_PLAYBACK_MODE=applescript
# Apple Music 곡 검색 국가 (매장 Apple 계정 국가와 같게, 예: kr). 비워두면 iTunes 기본값이에요.
# APPLE_MUSIC_COUNTRY=kr
# 외부 음악 앱/플레이어 실행 차단 (준비 완료로 표시하지 않아요)
# PLAYBACK_DISABLED=1
